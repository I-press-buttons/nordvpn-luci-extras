#!/usr/bin/ucode -S
// SPDX-License-Identifier: MIT
// One-shot NordVPN apply worker. Spawned detached by the rpcd `apply_start`
// method and safe to run manually. Applies ONE instance and records the
// outcome in the apply-status file the LuCI page polls, so an apply that takes
// tens of seconds never blocks a ubus call.

'use strict';

const _apply = require('nordvpn.apply');
const _common = require('nordvpn.common');
const log = _common.log,
      validate_instance = _common.validate_instance;

// `--restore-wan` only re-checks the WAN's default route (see
// nordvpn.apply.restore_wan_default); rpcd hands that to this worker so a
// routing-only apply does not hold up every other ubus call while it waits.
if (length(ARGV) > 0 && ARGV[0] == '--restore-wan') {
	_apply.restore_wan_default();
	exit(0);
}

// Optional arguments: the instance to apply (default 'main') and what started
// the apply, for the event history (default 'external', i.e. not the UI).
let instance = (length(ARGV) > 0 ? validate_instance(ARGV[0]) : null) || 'main';
let res = _apply.run_apply(instance, length(ARGV) > 1 ? ARGV[1] : null);

if (res.skipped) {
	printf('nordvpn-apply: skipped (%s)\n', res.reason);
	exit(0);
}
if (res.state == 'success') {
	printf('nordvpn-apply: %s connected to %s\n', instance, res.gateway);
	exit(0);
}

log('apply failed: ' + (res.error || 'unknown error'));
exit(1);
