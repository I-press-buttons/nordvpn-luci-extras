#!/usr/bin/ucode -S
// SPDX-License-Identifier: MIT
// Foreground scheduler daemon supervised by procd. Refreshes the server-list
// cache and triggers rotation on schedule, running each job in a short-lived
// child (uloop.task) so a slow job never stalls the loop. Overlap is prevented
// by the workers' own lock files. Timing decisions live in nordvpn.service.
// Also runs the optional egress probe (a ping through each tunnel, in a child
// as well) and the watchdog that recovers an unhealthy tunnel.

'use strict';

import * as uloop from 'uloop';
import { cursor } from 'uci';
const _common = require('nordvpn.common');
const load_settings = _common.load_settings,
      list_instances = _common.list_instances,
      cache_file_path = _common.cache_file_path,
      log = _common.log;
const _cache = require('nordvpn.cache');
const fetch_and_build = _cache.fetch_and_build,
      cache_is_stale = _cache.cache_is_stale;
const _rotate = require('nordvpn.rotate');
const rotate = _rotate.rotate,
      last_attempt_ts = _rotate.last_attempt_ts,
      mark_attempt = _rotate.mark_attempt,
      read_state = _rotate.read_state,
      record = _rotate.record;
const _service = require('nordvpn.service');
const should_refresh = _service.should_refresh,
      should_rotate = _service.should_rotate,
      should_recover = _service.should_recover,
      watchdog_update = _service.watchdog_update,
      watchdog_result_update = _service.watchdog_result_update,
      should_probe = _service.should_probe,
      effective_state = _service.effective_state,
      probe_update = _service.probe_update,
      probe_clear = _service.probe_clear;
const _status = require('nordvpn.status');
const status = _status.status,
      egress_probe = _status.egress_probe;
const record_event = require('nordvpn.history').record_event;

uloop.init();

let last_cache = 0;
// Instances with a probe child in flight: a slow probe (every target timing
// out) must not pile up a second one behind it.
let probing = {};

// Ping through the tunnel in a child and fold the result into the persisted
// probe fields when it returns. Only transitions reach the event history.
function start_probe(inst, dev, gateway, targets) {
	probing[inst] = true;
	uloop.task(
		function() { return egress_probe(dev, targets); },
		function(result) {
			delete probing[inst];
			// A child that died without a result says nothing about the
			// tunnel; do not count it as a failed probe.
			if (type(result) != 'object')
				return;
			let u =probe_update(read_state(inst) || {}, result, gateway, time());
			record(u.fields, inst);
			if (u.event == 'egress_lost') {
				log('egress probe: ' + inst + ' forwards no traffic through ' + gateway);
				record_event(inst, 'egress_lost', { server: gateway,
					detail: 'no reply from ' + join(', ', targets) });
			} else if (u.event == 'egress_restored') {
				log('egress probe: ' + inst + ' forwards traffic again');
				record_event(inst, 'egress_restored', { server: gateway, detail: 'reply from ' + result.target });
			}
		}
	);
}

function tick() {
	// Fresh cursor each tick so committed config changes are picked up.
	let uci = cursor();
	let now = time();
	let lt = localtime();
	let hm = sprintf('%02d:%02d', lt.hour, lt.min);

	// The server-list cache is shared by all instances; refresh it once.
	let shared = load_settings(uci);
	let path = cache_file_path(shared);
	if (should_refresh(shared, last_cache, now, cache_is_stale(path))) {
		last_cache = now;
		uloop.task(function() { fetch_and_build(path); });
	}

	// The rotation clock is persisted (nordvpn.rotate state), not in memory:
	// procd restarts this daemon on every config change, and an in-memory
	// counter would reset to 0 each time and make should_rotate() fire on the
	// next tick. The first time rotation is active we only start the clock, so
	// enabling rotation waits a full interval instead of rotating immediately.
	for (let name in list_instances(uci)) {
		let inst = name; // fresh binding for the task closure
		let s = load_settings(uci, inst);
		let last = last_attempt_ts(inst);
		if (last == 0 && s.enabled && s.rotation_enabled && !(s.fixed_server && s.fixed_server != '')) {
			mark_attempt(now, inst);
		} else if (should_rotate(s, last, now, hm)) {
			mark_attempt(now, inst);
			uloop.task(function() { rotate(null, inst, 'schedule'); });
		}

		// Watchdog timers persist in the per-instance rotate state across daemon
		// restarts. Ineligible instances clear that state without a status probe,
		// so enabling or unpinning always starts with a fresh grace window. The
		// egress probe is independent of the watchdog (it also feeds the status
		// page), so a status read happens when either one is on.
		let st = read_state(inst) || {};
		let ds = (type(st.degraded_since) == 'int') ? st.degraded_since : 0;
		let last_recover = (type(st.last_recover) == 'int') ? st.last_recover : 0;
		let fails = (type(st.recover_fails) == 'int') ? st.recover_fails : 0;
		let active = s.enabled && s.watchdog &&
			!(s.fixed_server && s.fixed_server != '');
		let probe_on = s.enabled && s.egress_probe;
		if (!probe_on) {
			let clr = probe_clear(st);
			if (clr)
				record(clr, inst);
		}
		if (!active) {
			let upd = watchdog_update(null, {
				degraded_since: ds,
				last_recover: last_recover,
				recover_fails: fails
			}, now, false);
			if (upd.degraded_since != ds || upd.last_recover != last_recover ||
			    upd.recover_fails != fails)
				record(upd, inst);
			if (!probe_on)
				continue;
		}

		let cur = status(uci, inst);
		if (should_probe(s, cur.state) && cur.device && cur.gateway && !probing[inst])
			start_probe(inst, cur.device, cur.gateway, s.probe_targets);
		if (!active)
			continue;

		// A tunnel whose handshake is fresh but whose probe keeps failing is
		// 'no_egress' here, which the watchdog treats like a stale handshake.
		let state = effective_state(s, cur.state, st, cur.gateway);
		let upd = watchdog_update(state, {
			degraded_since: ds,
			last_recover: last_recover,
			recover_fails: fails
		}, now, true);
		if (upd.degraded_since != ds || upd.last_recover != last_recover ||
		    upd.recover_fails != fails) {
			record(upd, inst);
			ds = upd.degraded_since;
			last_recover = upd.last_recover;
			fails = upd.recover_fails;
		}
		if (should_recover(s, state, ds, last_recover, fails, now)) {
			// Claim the attempt before forking so overlapping ticks cannot
			// double-fire. The worker result advances backoff only for a real
			// failed recovery, not when another rotation owns the lock.
			record({ last_recover: now }, inst);
			record_event(inst, 'watchdog', { server: cur.gateway, reason: state,
				detail: sprintf('unhealthy for %d s', now - ds) });
			uloop.task(
				function() { return rotate(null, inst, 'watchdog'); },
				function(result) {
					let latest = read_state(inst) || {};
					let current = (type(latest.recover_fails) == 'int')
						? latest.recover_fails : 0;
					let next = watchdog_result_update(result, current);
					if (next != current)
						record({ recover_fails: next }, inst);
				}
			);
		}
	}
}

// Re-check every 30s; run once immediately at startup.
uloop.interval(30000, tick);
tick();
uloop.run();
