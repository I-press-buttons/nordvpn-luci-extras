#!/usr/bin/ucode -S
// SPDX-License-Identifier: MIT
// One-shot NordVPN rotation worker. Invoked by the nordvpn procd service and
// safe to run manually. Reads the schedule/selection from /etc/config/nordvpn.
// With --job (spawned detached by the rpcd `rotate_start` method) the outcome
// is also recorded in the job-status file the LuCI page polls.

'use strict';

const _rotate = require('nordvpn.rotate');
const _common = require('nordvpn.common');
const log = _common.log,
      validate_instance = _common.validate_instance;

// Optional arguments: --job, then the instance to rotate (default 'main').
let args = [ ...ARGV ];
let job = length(args) > 0 && args[0] == '--job';
if (job)
	shift(args);
let instance = (length(args) > 0 ? validate_instance(args[0]) : null) || 'main';
let res = job ? _rotate.run_job(instance) : _rotate.rotate(null, instance, 'manual');

if (res.ok) {
	printf('nordvpn-rotate: connected to %s\n', res.server);
	exit(0);
}
if (res.skipped) {
	printf('nordvpn-rotate: skipped (%s)\n', res.reason);
	exit(0);
}

log('rotation failed: ' + (res.error || 'unknown error'));
exit(1);
